{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "scripts", "vite.config.ts", "vite.review.config.ts", "vitest.config.ts", "vitest.e2e.config.ts"],
  "exclude": [
    "scripts/_checkpoint_card00.ts",
    "scripts/_verify_*.ts",
    "scripts/simulate-endgame.ts",
    "scripts/verify-endgame-review.ts"
  ]
}
